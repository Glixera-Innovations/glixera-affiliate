{
  "name": "glixera-affiliate",
  "version": "0.2.0",
  "description": "Discord bot for managing Glixera Innovations partnership checkups.",
  "private": true,
  "type": "module",
  "main": "dist/bootstrap.js",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/bootstrap.ts",
    "start": "node --enable-source-maps dist/bootstrap.js",
    "start:local": "node --env-file-if-exists=.env --enable-source-maps dist/bootstrap.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
